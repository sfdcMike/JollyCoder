{
  "display_information": {
    "name": "jollyRodger",
    "description": "A pirate-themed code assistant. Helps ye ship code! 🏴‍☠️",
    "background_color": "#1a1a2e"
  },
  "features": {
    "agent_view": {
    "agent_description": "Arr, I be Jolly — yer pirate code assistant! I'll help ye ship code and leave only the finest pirate-style comments in me wake. 🏴‍☠️",
    "suggested_prompts": [
        { "title": "Add pirate comments", "message": "Add pirate-style comments to this code: " },
        { "title": "Debug me code", "message": "Help me find the bug in this code, matey: " },
        { "title": "Review this code", "message": "Review this code for a landlubber: " }
      ]
    },
    "code_channels": {
    "enabled": true
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Jolly Rodger",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://ngrok-free.app/slack/oauth_redirect"],
    "scopes": {
      "user": [
        "search:read",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "im:history",
        "mpim:history",
        "users:read",
        "search:read.public",
        "search:read.private",
        "search:read.mpim",
        "search:read.im",
        "search:read.files",
        "search:read.users",
        "chat:write",
        "canvases:read",
        "canvases:write",
        "users:read.email"
      ],
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "groups:history",
        "im:history",
        "im:read",
        "im:write",
        "reactions:write",
        "reactions:read",
        "users:read",
        "assistant:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://ngrok-free.app/slack/events",
      "bot_events": ["app_home_opened", "app_mention", "message.channels", "message.groups", "message.im","message_stream_stopped"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://ngrok-free.app/slack/events"
    },
    "is_mcp_enabled": true,
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
